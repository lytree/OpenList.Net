<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenList.Desktop.ViewModels"
             x:Class="OpenList.Desktop.Views.DashboardView"
             x:DataType="vm:DashboardViewModel"
             x:CompileBindings="False">

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,20" Spacing="14" MaxWidth="980" HorizontalAlignment="Stretch">

      <!-- ===== 核心管理（QuickActionsCard） ===== -->
      <Border Classes="card" Padding="18">
        <StackPanel Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="icon accent" Data="{StaticResource I.Settings}" Width="18" Height="18"
                  VerticalAlignment="Center" />
            <TextBlock Classes="card-title" Text="{DynamicResource L.dash.coreTitle}" VerticalAlignment="Center" />
          </StackPanel>

          <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
            <!-- OpenList 核心（随桌面端一起发布，无需单独管理版本） -->
            <Border Classes="subcard">
              <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Classes="card-title" Text="{DynamicResource L.dash.core}" FontSize="13" VerticalAlignment="Center" />
                  <Border Classes="tag" VerticalAlignment="Center" IsVisible="{Binding HasCoreVersion}">
                    <TextBlock Text="{Binding CoreVersionText}" FontSize="11"
                               Foreground="{DynamicResource Brush.TextSecondary}" />
                  </Border>
                </StackPanel>
                <WrapPanel>
                  <Button Classes="btn btn-primary" Command="{Binding ToggleCoreCommand}"
                          IsEnabled="{Binding !IsBusy}" MinWidth="92" Margin="0,0,8,6">
                    <Panel>
                      <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsRunning}">
                        <Path Classes="icon white" Data="{StaticResource I.Play}" Width="13" Height="13" />
                        <TextBlock Text="{DynamicResource L.dash.start}" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsRunning}">
                        <Path Classes="icon white" Data="{StaticResource I.Square}" Width="13" Height="13" />
                        <TextBlock Text="{DynamicResource L.dash.stop}" />
                      </StackPanel>
                    </Panel>
                  </Button>
                  <Button Classes="btn btn-secondary" Command="{Binding OpenWebCommand}"
                          IsEnabled="{Binding IsRunning}" Margin="0,0,8,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Path Classes="icon secondary" Data="{StaticResource I.Globe}" Width="13" Height="13" />
                      <TextBlock Text="{DynamicResource L.dash.web}" />
                    </StackPanel>
                  </Button>
                  <Button Classes="btn btn-secondary" Command="{Binding CopyAdminPasswordCommand}"
                          ToolTip.Tip="{DynamicResource L.dash.copyPasswordTip}" Padding="9,6" Margin="0,0,8,6">
                    <Path Classes="icon secondary" Data="{StaticResource I.Key}" Width="14" Height="14" />
                  </Button>
                  <Button Classes="btn btn-secondary" Command="{Binding ResetAdminPasswordCommand}"
                          ToolTip.Tip="{DynamicResource L.dash.resetPasswordTip}" Padding="9,6" Margin="0,0,8,6">
                    <Path Classes="icon secondary" Data="{StaticResource I.RotateCcw}" Width="14" Height="14" />
                  </Button>
                  <Button Classes="btn btn-success" Command="{Binding ToggleFirewallCommand}"
                          IsEnabled="{Binding !FirewallBusy}" ToolTip.Tip="{DynamicResource L.dash.allowPortTip}" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Path Classes="icon white" Data="{StaticResource I.Shield}" Width="13" Height="13" />
                      <TextBlock Text="{DynamicResource L.dash.allowPort}" />
                    </StackPanel>
                  </Button>
                </WrapPanel>
              </StackPanel>
            </Border>

            <!-- RClone -->
            <Border Classes="subcard" Grid.Column="1">
              <StackPanel Spacing="10">
                <TextBlock Classes="card-title" Text="RClone" FontSize="13" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="btn btn-secondary" HorizontalAlignment="Stretch"
                          Command="{Binding OpenRcloneConfigCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Path Classes="icon secondary" Data="{StaticResource I.Settings}" Width="13" Height="13" />
                      <TextBlock Text="{DynamicResource L.dash.configureRclone}" />
                    </StackPanel>
                  </Button>
                  <Button Classes="btn btn-secondary" HorizontalAlignment="Stretch"
                          Command="{Binding ManageMountsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Path Classes="icon secondary" Data="{StaticResource I.HardDrive}" Width="13" Height="13" />
                      <TextBlock Text="{DynamicResource L.dash.manageMounts}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ===== 登录凭据（首次启动自动建号 / 密码展示） ===== -->
      <Border Classes="card" Padding="18">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="icon accent" Data="{StaticResource I.Key}" Width="18" Height="18"
                  VerticalAlignment="Center" />
            <TextBlock Classes="card-title" Text="{DynamicResource L.dash.credTitle}"
                       VerticalAlignment="Center" />
          </StackPanel>

          <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
            <TextBlock Classes="muted" Text="{DynamicResource L.dash.credUser}"
                       FontSize="12" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding AdminUsernameText}"
                       FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="btn btn-secondary"
                    Command="{Binding CopyAdminUsernameCommand}"
                    ToolTip.Tip="{DynamicResource L.dash.copyUsernameTip}" Padding="8,4"
                    VerticalAlignment="Center">
              <Path Classes="icon secondary" Data="{StaticResource I.Copy}" Width="13" Height="13" />
            </Button>
            <TextBlock Grid.Column="3" Classes="muted" Text="{DynamicResource L.dash.credPassword}"
                       FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0" />
            <TextBlock Grid.Column="4" Text="{Binding AdminPasswordText}"
                       FontSize="13" VerticalAlignment="Center" TextWrapping="NoWrap" />
            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8">
              <Button Classes="btn btn-secondary" Content="{Binding AdminPasswordToggleText}"
                      Command="{Binding ToggleAdminPasswordCommand}"
                      IsEnabled="{Binding HasAdminCredentials}" Padding="12,5" />
              <Button Classes="btn btn-secondary" Command="{Binding CopyAdminPasswordCommand}"
                      ToolTip.Tip="{DynamicResource L.dash.copyPasswordTip}" Padding="8,4"
                      IsEnabled="{Binding HasAdminCredentials}">
                <Path Classes="icon secondary" Data="{StaticResource I.Copy}" Width="13" Height="13" />
              </Button>
              <Button Classes="btn btn-secondary" Content="{DynamicResource L.dash.openInitPage}"
                      Command="{Binding OpenInitPageCommand}" IsVisible="{Binding !HasAdminCredentials}"
                      IsEnabled="{Binding IsRunning}" Padding="12,5" />
            </StackPanel>
          </Grid>

          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding CredentialsHint}" />
        </StackPanel>
      </Border>

      <!-- ===== 核心监控 + 版本管理 ===== -->
      <Grid ColumnDefinitions="1.1,*" ColumnSpacing="14">

        <!-- 核心监控 -->
        <Border Classes="card" Padding="18">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Classes="icon accent" Data="{StaticResource I.Eye}" Width="18" Height="18"
                    VerticalAlignment="Center" />
              <TextBlock Classes="card-title" Text="{DynamicResource L.dash.monitorTitle}" VerticalAlignment="Center" />
              <Border Classes="pill" Background="#B334C759" IsVisible="{Binding IsRunning}" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource L.dash.online}" FontSize="11" Foreground="White" />
              </Border>
              <Border Classes="pill" Background="#80FF3B30" IsVisible="{Binding !IsRunning}" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource L.dash.offline}" FontSize="11" Foreground="White" />
              </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsRunning}">
              <Border Classes="tag" Padding="10,4" CornerRadius="999">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Path Classes="icon accent" Data="{StaticResource I.Globe}" Width="12" Height="12" />
                  <TextBlock Text="{Binding PortLabel}" FontSize="11"
                             Foreground="{DynamicResource Brush.TextSecondary}" />
                </StackPanel>
              </Border>
              <Border Classes="tag" Padding="10,4" CornerRadius="999">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Path Classes="icon accent" Data="{StaticResource I.Activity}" Width="12" Height="12" />
                  <TextBlock Text="{Binding ResponseTimeLabel}" FontSize="11"
                             Foreground="{DynamicResource Brush.TextSecondary}" />
                </StackPanel>
              </Border>
              <Border Classes="tag" Padding="10,4" CornerRadius="999" Background="{DynamicResource Brush.BgSecondary}">
                <TextBlock Text="{Binding AvgResponseTimeText}" FontSize="11"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
              </Border>
              <Border Classes="tag" Padding="10,4" CornerRadius="999" Background="{DynamicResource Brush.BgSecondary}">
                <TextBlock Text="{Binding UptimeRateText}" FontSize="11"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
              </Border>
            </StackPanel>

            <!-- 心跳图（上游 grid + heartbeat SVG 复刻） -->
            <Border Background="{DynamicResource Brush.BgSecondary}" CornerRadius="8"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    Height="150" Padding="1">
              <Canvas x:Name="ChartCanvas" SizeChanged="OnChartSizeChanged" />
            </Border>
          </StackPanel>
        </Border>

        <!-- Rclone 管理（OpenList 核心随桌面端一起发布，不单独管理版本） -->
        <Border Classes="card" Grid.Column="1" Padding="18">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Classes="icon accent" Data="{StaticResource I.Download}" Width="18" Height="18"
                    VerticalAlignment="Center" />
              <TextBlock Classes="card-title" Text="{DynamicResource L.dash.rcloneTitle}" VerticalAlignment="Center" />
            </StackPanel>

            <Border Classes="subcard" Background="{DynamicResource Brush.BgPrimary}">
              <StackPanel Spacing="8">
                <StackPanel Spacing="4">
                  <TextBlock Classes="card-title" Text="{DynamicResource L.dash.rclone}" FontSize="13" />
                  <Border Classes="tag" HorizontalAlignment="Left" IsVisible="{Binding HasRcloneVersion}">
                    <TextBlock Text="{Binding RcloneVersionText}" FontSize="11"
                               Foreground="{DynamicResource Brush.TextSecondary}" />
                  </Border>
                </StackPanel>
                <ComboBox ItemsSource="{Binding RcloneVersions}" SelectedItem="{Binding SelectedRcloneVersion}"
                          PlaceholderText="{DynamicResource L.dash.selectVersion}" MinHeight="30" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left" FontSize="12" />
                <Button Classes="btn btn-primary" Command="{Binding UpdateRcloneCommand}"
                        HorizontalAlignment="Stretch">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Classes="icon white" Data="{StaticResource I.Download}" Width="13" Height="13" />
                    <TextBlock Text="{DynamicResource L.dash.update}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </Grid>

      <!-- ===== 进程监控（核心子进程 CPU/内存/线程/句柄） ===== -->
      <Border Classes="card" Padding="18">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="icon accent" Data="{StaticResource I.Monitor}" Width="18" Height="18"
                  VerticalAlignment="Center" />
            <TextBlock Classes="card-title" Text="{DynamicResource L.dash.processTitle}" VerticalAlignment="Center" />
            <TextBlock Classes="muted" Text="OpenList.Server" VerticalAlignment="Center" FontSize="12" />
            <Border Classes="pill" Background="#B334C759" IsVisible="{Binding Monitor.IsRunning}"
                    VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource L.dash.pillRunning}" FontSize="11" Foreground="White" />
            </Border>
            <Border Classes="pill" Background="#80FF3B30" IsVisible="{Binding !Monitor.IsRunning}"
                    VerticalAlignment="Center">
              <TextBlock Text="{Binding Monitor.StatusText}" FontSize="11" Foreground="White" />
            </Border>
          </StackPanel>

          <!-- 指标行 -->
          <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="10" IsVisible="{Binding Monitor.IsRunning}">
            <Border Classes="subcard" Padding="10,8">
              <StackPanel Spacing="2">
                <TextBlock Classes="muted" Text="{DynamicResource L.dash.metricPid}" FontSize="11" />
                <TextBlock Text="{Binding Monitor.PidText}" FontSize="15" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Classes="subcard" Padding="10,8" Grid.Column="1">
              <StackPanel Spacing="2">
                <TextBlock Classes="muted" Text="{DynamicResource L.dash.metricUptime}" FontSize="11" />
                <TextBlock Text="{Binding Monitor.UptimeText}" FontSize="15" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Classes="subcard" Padding="10,8" Grid.Column="2">
              <StackPanel Spacing="2">
                <TextBlock Classes="muted" Text="{DynamicResource L.dash.metricCpu}" FontSize="11" />
                <TextBlock Text="{Binding Monitor.CpuText}" FontSize="15" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Classes="subcard" Padding="10,8" Grid.Column="3">
              <StackPanel Spacing="2">
                <TextBlock Classes="muted" Text="{DynamicResource L.dash.metricMemory}" FontSize="11" />
                <TextBlock Text="{Binding Monitor.MemText}" FontSize="15" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Classes="subcard" Padding="10,8" Grid.Column="4">
              <StackPanel Spacing="2">
                <TextBlock Classes="muted" Text="{DynamicResource L.dash.metricThreads}" FontSize="11" />
                <TextBlock Text="{Binding Monitor.ThreadsText}" FontSize="15" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Classes="subcard" Padding="10,8" Grid.Column="5">
              <StackPanel Spacing="2">
                <TextBlock Classes="muted" Text="{DynamicResource L.dash.metricHandles}" FontSize="11" />
                <TextBlock Text="{Binding Monitor.HandlesText}" FontSize="15" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
          </Grid>

          <TextBlock Classes="muted" FontSize="12"
                     Text="{DynamicResource L.dash.processIdle}"
                     IsVisible="{Binding !Monitor.IsRunning}" />

          <!-- CPU / 内存曲线 -->
          <Grid ColumnDefinitions="*,*" ColumnSpacing="14" IsVisible="{Binding Monitor.IsRunning}">
            <Border Classes="subcard" Padding="14">
              <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Classes="icon accent" Data="{StaticResource I.Activity}" Width="14" Height="14"
                        VerticalAlignment="Center" />
                  <TextBlock Classes="card-title" Text="{DynamicResource L.dash.cpuTitle}" FontSize="13" VerticalAlignment="Center" />
                  <Border Classes="tag" Padding="10,4" CornerRadius="999" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Monitor.CpuText}" FontSize="11"
                               Foreground="{DynamicResource Brush.TextSecondary}" />
                  </Border>
                </StackPanel>
                <Border Background="{DynamicResource Brush.BgSecondary}" CornerRadius="8"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        Height="140" Padding="1">
                  <Canvas x:Name="CpuCanvas" SizeChanged="OnChartSizeChanged" />
                </Border>
              </StackPanel>
            </Border>

            <Border Classes="subcard" Padding="14" Grid.Column="1">
              <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Classes="icon accent" Data="{StaticResource I.HardDrive}" Width="14" Height="14"
                        VerticalAlignment="Center" />
                  <TextBlock Classes="card-title" Text="{DynamicResource L.dash.memoryTitle}" FontSize="13" VerticalAlignment="Center" />
                  <Border Classes="tag" Padding="10,4" CornerRadius="999" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Monitor.MemText}" FontSize="11"
                               Foreground="{DynamicResource Brush.TextSecondary}" />
                  </Border>
                </StackPanel>
                <Border Background="{DynamicResource Brush.BgSecondary}" CornerRadius="8"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        Height="140" Padding="1">
                  <Canvas x:Name="MemCanvas" SizeChanged="OnChartSizeChanged" />
                </Border>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ===== 文档与链接（DocumentationCard） ===== -->
      <Border Classes="card" Padding="18">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
            <!-- OpenList -->
            <Border Classes="subcard" Padding="14">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="card-title" Text="OpenList" FontSize="13" />
                    <TextBlock Classes="muted" Text="{DynamicResource L.dash.openListDesc}" />
                  </StackPanel>
                  <Border Width="32" Height="32" CornerRadius="8" VerticalAlignment="Top"
                          Background="{DynamicResource Brush.Indigo}">
                    <Path Classes="icon white" Data="{StaticResource I.BookOpen}" Width="17" Height="17" />
                  </Border>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="btn btn-primary" HorizontalAlignment="Stretch" Command="{Binding OpenDocsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Path Classes="icon white" Data="{StaticResource I.ExternalLink}" Width="13" Height="13" />
                      <TextBlock Text="{DynamicResource L.dash.openDocs}" />
                    </StackPanel>
                  </Button>
                  <Button Classes="btn btn-secondary" HorizontalAlignment="Stretch"
                          Command="{Binding OpenOpenListGithubCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Path Classes="icon secondary" Data="{StaticResource I.Github}" Width="13" Height="13" />
                      <TextBlock Text="GitHub" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Rclone -->
            <Border Classes="subcard" Padding="14" Grid.Column="1">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="card-title" Text="{DynamicResource L.dash.rclone}" FontSize="13" />
                    <TextBlock Classes="muted" Text="{DynamicResource L.dash.rcloneDesc}" />
                  </StackPanel>
                  <Border Width="32" Height="32" CornerRadius="8" VerticalAlignment="Top"
                          Background="{DynamicResource Brush.Success}">
                    <Path Classes="icon white" Data="{StaticResource I.Cloud}" Width="17" Height="17" />
                  </Border>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="btn btn-primary" HorizontalAlignment="Stretch"
                          Command="{Binding OpenRcloneDocsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Path Classes="icon white" Data="{StaticResource I.ExternalLink}" Width="13" Height="13" />
                      <TextBlock Text="{DynamicResource L.dash.openDocs}" />
                    </StackPanel>
                  </Button>
                  <Button Classes="btn btn-secondary" HorizontalAlignment="Stretch"
                          Command="{Binding OpenRcloneGithubCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Path Classes="icon secondary" Data="{StaticResource I.Github}" Width="13" Height="13" />
                      <TextBlock Text="GitHub" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>

          <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
            <Button Classes="btn btn-secondary" Command="{Binding OpenApiDocsCommand}" HorizontalAlignment="Stretch">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="icon secondary" Data="{StaticResource I.Code}" Width="13" Height="13" />
                <TextBlock Text="{DynamicResource L.dash.apiDocs}" />
              </StackPanel>
            </Button>
            <Button Classes="btn btn-secondary" Grid.Column="1" Command="{Binding OpenMountCommandsCommand}"
                    HorizontalAlignment="Stretch">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="icon secondary" Data="{StaticResource I.Terminal}" Width="13" Height="13" />
                <TextBlock Text="{DynamicResource L.dash.mountCommands}" />
              </StackPanel>
            </Button>
            <Button Classes="btn btn-secondary" Grid.Column="2" Command="{Binding OpenIssuesCommand}"
                    HorizontalAlignment="Stretch">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="icon secondary" Data="{StaticResource I.Info}" Width="13" Height="13" />
                <TextBlock Text="{DynamicResource L.dash.issues}" />
              </StackPanel>
            </Button>
            <Button Classes="btn btn-secondary" Grid.Column="3" Command="{Binding OpenFaqCommand}"
                    HorizontalAlignment="Stretch">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="icon secondary" Data="{StaticResource I.MessageCircle}" Width="13" Height="13" />
                <TextBlock Text="{DynamicResource L.dash.faq}" />
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
