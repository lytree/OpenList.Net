<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenList.Desktop.ViewModels"
             xmlns:controls="using:OpenList.Desktop.Controls"
             x:Class="OpenList.Desktop.Views.LogsView"
             x:DataType="vm:LogsViewModel"
             x:CompileBindings="False">
  <UserControl.KeyBindings>
    <!-- 工具提示里承诺过的快捷键，这里才是真正生效的地方 -->
    <KeyBinding Gesture="Space" Command="{Binding TogglePauseCommand}" />
    <KeyBinding Gesture="Ctrl+R" Command="{Binding RefreshCommand}" />
    <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyAllAsyncCommand}" />
    <KeyBinding Gesture="Ctrl+E" Command="{Binding ExportAsyncCommand}" />
    <KeyBinding Gesture="Ctrl+Delete" Command="{Binding ClearCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Resources>
    <!-- 四个单元格模板：列定义在 VM 里组装（要拿到这里的模板实例） -->
    <DataTemplate x:Key="LogCellTime">
      <TextBlock Text="{Binding Time}" TextTrimming="CharacterEllipsis" />
    </DataTemplate>
    <DataTemplate x:Key="LogCellLevel">
      <Border CornerRadius="5" Padding="7,1" HorizontalAlignment="Left" VerticalAlignment="Center"
              Background="{Binding LevelBackground}">
        <TextBlock Text="{Binding LevelText}" FontSize="10" FontWeight="SemiBold"
                   FontFamily="Segoe UI" Foreground="{Binding LevelForeground}" />
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="LogCellSource">
      <TextBlock Text="{Binding Source}" TextTrimming="CharacterEllipsis" />
    </DataTemplate>
    <DataTemplate x:Key="LogCellMessage">
      <TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
    </DataTemplate>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24,20" RowSpacing="12" MaxWidth="1200">

    <!-- ===== 工具条（上游 LogView toolbar） ===== -->
    <Border Classes="card" Padding="12,10">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Classes="btn-icon" Command="{Binding TogglePauseCommand}" ToolTip.Tip="{DynamicResource L.log.pauseTip}">
            <Panel>
              <Path Classes="icon accent" Data="{StaticResource I.Pause}" Width="16" Height="16"
                    IsVisible="{Binding !Paused}" />
              <Path Classes="icon accent" Data="{StaticResource I.Play}" Width="16" Height="16"
                    IsVisible="{Binding Paused}" />
            </Panel>
          </Button>
          <Button Classes="btn-icon" Command="{Binding RefreshCommand}" ToolTip.Tip="{DynamicResource L.log.refreshTip}">
            <Path Classes="icon accent" Data="{StaticResource I.RefreshCw}" Width="16" Height="16" />
          </Button>
          <Button Classes="btn-icon" ToolTip.Tip="{DynamicResource L.log.filterTip}">
            <Path Classes="icon white" Data="{StaticResource I.Filter}" Width="16" Height="16" />
          </Button>
          <TextBox Text="{Binding SearchText}" PlaceholderText="{DynamicResource L.log.searchPlaceholder}" MinWidth="260"
                   VerticalAlignment="Center" Height="32" />
        </StackPanel>

        <TextBlock Grid.Column="1" Text="{Binding StatsText}" Classes="muted" VerticalAlignment="Center"
                   HorizontalAlignment="Right" Margin="0,0,10,0" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Classes="btn-icon" Command="{Binding CopyAllAsyncCommand}" ToolTip.Tip="{DynamicResource L.log.copyTip}">
            <Path Classes="icon secondary" Data="{StaticResource I.Copy}" Width="15" Height="15" />
          </Button>
          <Button Classes="btn-icon" Command="{Binding ExportAsyncCommand}" ToolTip.Tip="{DynamicResource L.log.exportTip}">
            <Path Classes="icon secondary" Data="{StaticResource I.Download}" Width="15" Height="15" />
          </Button>
          <Button Classes="btn-icon" Command="{Binding ClearCommand}" ToolTip.Tip="{DynamicResource L.log.clearTip}">
            <Path Classes="icon secondary" Data="{StaticResource I.Trash}" Width="15" Height="15" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== 筛选行 ===== -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
      <ComboBox SelectedIndex="{Binding LevelIndex}" MinHeight="30" MinWidth="110" FontSize="12">
        <ComboBoxItem Content="{DynamicResource L.log.levelAll}" />
        <ComboBoxItem Content="{DynamicResource L.log.levelInfo}" />
        <ComboBoxItem Content="{DynamicResource L.log.levelWarn}" />
        <ComboBoxItem Content="{DynamicResource L.log.levelError}" />
      </ComboBox>
      <ComboBox Grid.Column="1" SelectedIndex="{Binding SourceIndex}" MinHeight="30" MinWidth="110" FontSize="12">
        <ComboBoxItem Content="{DynamicResource L.log.sourceAll}" />
        <ComboBoxItem Content="OpenList" />
        <ComboBoxItem Content="Rclone" />
        <ComboBoxItem Content="{DynamicResource L.log.sourceDesktop}" />
      </ComboBox>
      <CheckBox Grid.Column="3" Content="{DynamicResource L.log.selectAll}" IsEnabled="False" VerticalAlignment="Center" FontSize="12" />
      <CheckBox Grid.Column="4" Content="{DynamicResource L.log.clearSelection}" IsEnabled="False" VerticalAlignment="Center" FontSize="12" />
      <CheckBox Grid.Column="5" Content="{DynamicResource L.log.autoScroll}" IsChecked="{Binding AutoScroll}" VerticalAlignment="Center"
                FontSize="12" />
    </Grid>

    <!-- ===== 日志表格 ===== -->
    <Border Classes="card" Grid.Row="2" Padding="4">
      <controls:LogTable x:Name="Table"
                         Rows="{Binding Filtered}"
                         Columns="{Binding TableColumns}"
                         RowHeight="26"
                         FollowTail="{Binding AutoScroll}"
                         FontFamily="Consolas, Menlo, monospace"
                         FontSize="12" />
    </Border>

    <!-- ===== 底部状态条 ===== -->
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
      <TextBlock Text="{Binding StatusText}" Classes="muted" />
      <TextBlock Grid.Column="1" Text="{Binding RecordsText}" Classes="muted" />
    </Grid>
  </Grid>
</UserControl>
