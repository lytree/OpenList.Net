<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenList.Desktop.ViewModels"
             x:Class="OpenList.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             x:CompileBindings="False">

  <UserControl.Styles>
    <Style Selector="ListBox.tabs">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="ListBox.tabs > ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.tabs > ListBoxItem ContentPresenter">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.tabs > ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.SegmentedBg}" />
    </Style>
    <Style Selector="ListBox.tabs > ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector="ListBox.tabs > ListBoxItem TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="Padding" Value="0,7" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style Selector="ListBox.tabs > ListBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <!-- 设置项分组框 -->
    <Style Selector="Border.field">
      <Setter Property="Background" Value="{DynamicResource Brush.BgSecondary}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,20" Spacing="14" MaxWidth="980" HorizontalAlignment="Stretch">

      <!-- ===== 头卡 ===== -->
      <Border Classes="card" Padding="16,14">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Border Classes="icon-chip" Width="34" Height="34">
              <Path Classes="icon white" Data="{StaticResource I.Settings}" Width="18" Height="18" />
            </Border>
            <StackPanel Spacing="1">
              <TextBlock Classes="h1" Text="{DynamicResource L.set.title}" />
              <TextBlock Classes="muted" Text="{DynamicResource L.set.subtitle}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="btn btn-secondary" Command="{Binding ResetAllCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="icon secondary" Data="{StaticResource I.RotateCcw}" Width="13" Height="13" />
                <TextBlock Text="{DynamicResource L.common.reset}" />
              </StackPanel>
            </Button>
            <Button Classes="btn btn-primary" Command="{Binding SaveCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="icon white" Data="{StaticResource I.Save}" Width="13" Height="13" />
                <TextBlock Text="{DynamicResource L.set.saveChanges}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ===== 分段选择器 ===== -->
      <Border Classes="card" Padding="6">
        <ListBox Classes="tabs" SelectedIndex="{Binding SelectedTabIndex}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <!-- 注意：不能用 Grid 做 ItemsPanel——Grid.Column 附加属性对生成项无效，会全部叠在第 0 列 -->
              <UniformGrid Rows="1" Columns="3" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBoxItem>
            <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
              <Path Classes="icon secondary" Data="{StaticResource I.Monitor}" Width="14" Height="14"
                    VerticalAlignment="Center" Margin="0,7,0,0" />
              <TextBlock Text="{DynamicResource L.set.tabService}" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem>
            <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
              <Path Classes="icon secondary" Data="{StaticResource I.HardDrive}" Width="14" Height="14"
                    VerticalAlignment="Center" Margin="0,7,0,0" />
              <TextBlock Text="{DynamicResource L.set.tabRclone}" />
            </StackPanel>
          </ListBoxItem>
          <ListBoxItem>
            <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
              <Path Classes="icon secondary" Data="{StaticResource I.Settings}" Width="14" Height="14"
                    VerticalAlignment="Center" Margin="0,7,0,0" />
              <TextBlock Text="{DynamicResource L.set.appTitle}" />
            </StackPanel>
          </ListBoxItem>
        </ListBox>
      </Border>

      <!-- ================= Tab 0：OpenList 服务 ================= -->
      <StackPanel Spacing="14" IsVisible="{Binding Tab0Visible}">

        <Border Classes="card" Padding="18">
          <StackPanel Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="icon-chip" Width="28" Height="28">
                <Path Classes="icon white" Data="{StaticResource I.Globe}" Width="14" Height="14" />
              </Border>
              <TextBlock Classes="card-title" Text="{DynamicResource L.set.networkTitle}" FontSize="15" VerticalAlignment="Center" />
            </StackPanel>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
              <StackPanel Spacing="14">
                <Border Classes="field">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource L.set.httpPort}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextMain}" />
                    <TextBox Text="{Binding HttpPort}" />
                  </StackPanel>
                </Border>
                <Border Classes="field">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource L.set.coreExePath}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextMain}" />
                    <TextBox Text="{Binding CoreExePath}" PlaceholderText="{DynamicResource L.set.coreExePlaceholder}" />
                    <Button Classes="btn btn-secondary" HorizontalAlignment="Left" Padding="8,4"
                            Command="{Binding BrowseCoreCommand}">
                      <Path Classes="icon secondary" Data="{StaticResource I.Folder}" Width="14" Height="14" />
                    </Button>
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Grid.Column="1" Spacing="14">
                <Border Classes="field">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource L.set.dataDir}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextMain}" />
                    <TextBox Text="{Binding DataDir}" PlaceholderText="{DynamicResource L.set.dataDirPlaceholder}" />
                    <Button Classes="btn btn-secondary" HorizontalAlignment="Left" Padding="8,4"
                            Command="{Binding BrowseDataDirCommand}">
                      <Path Classes="icon secondary" Data="{StaticResource I.Folder}" Width="14" Height="14" />
                    </Button>
                  </StackPanel>
                </Border>
                <Border Classes="field">
                  <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <ToggleSwitch IsEnabled="False" IsChecked="False" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource L.set.ssl}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextMain}" />
                    <TextBlock Text="{DynamicResource L.set.sslSoon}" Classes="muted" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="18">
          <StackPanel Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="icon-chip" Width="28" Height="28">
                <Path Classes="icon white" Data="{StaticResource I.Link}" Width="14" Height="14" />
              </Border>
              <TextBlock Classes="card-title" Text="{DynamicResource L.set.generalTitle}" FontSize="15" VerticalAlignment="Center" />
            </StackPanel>
            <Border Classes="field">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <ToggleSwitch IsChecked="{Binding AutoStartCore}" VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource L.set.autoStartCore}" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMain}" />
              </StackPanel>
            </Border>
            <Border Classes="field">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <ToggleSwitch IsChecked="{Binding AutoRestartCore}" VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource L.set.autoRestartCore}" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMain}" />
              </StackPanel>
            </Border>
            <Border Classes="field">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <ToggleSwitch IsChecked="{Binding StartMinimized}" VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource L.set.startMinimized}" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMain}" />
              </StackPanel>
            </Border>
            <Border Classes="field">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <ToggleSwitch IsChecked="{Binding CloseToTray}" VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource L.set.closeToTray}" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMain}" />
              </StackPanel>
            </Border>
            <Border Classes="field">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <ToggleSwitch IsChecked="{Binding AutoLogin}" VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource L.set.autoLogin}" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMain}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- 内置管理员密码：忘记密码时的恢复入口（该账号不可删除） -->
        <Border Classes="card" Padding="18">
          <StackPanel Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="icon-chip" Width="28" Height="28">
                <Path Classes="icon white" Data="{StaticResource I.Settings}" Width="14" Height="14" />
              </Border>
              <TextBlock Classes="card-title" Text="{DynamicResource L.set.adminPwdTitle}" FontSize="15" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="muted" Text="{DynamicResource L.set.adminPwdNote}" TextWrapping="Wrap" />
            <Border Classes="field">
              <StackPanel Spacing="8">
                <TextBlock Text="{DynamicResource L.set.adminPwdCurrent}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextMain}" />
                <TextBox Text="{Binding AdminPassword}" PasswordChar="•" />
              </StackPanel>
            </Border>
            <Border Classes="field">
              <StackPanel Spacing="8">
                <TextBlock Text="{DynamicResource L.set.adminPwdNew}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextMain}" />
                <TextBox Text="{Binding AdminPasswordNew}" PasswordChar="•" />
              </StackPanel>
            </Border>
            <Border Classes="field">
              <StackPanel Spacing="8">
                <TextBlock Text="{DynamicResource L.set.adminPwdConfirm}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextMain}" />
                <TextBox Text="{Binding AdminPasswordConfirm}" PasswordChar="•" />
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="btn btn-primary" HorizontalAlignment="Left"
                      Command="{Binding ChangeAdminPasswordCommand}">
                <TextBlock Text="{DynamicResource L.set.adminPwdSubmit}" />
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- ================= Tab 1：Rclone 存储 ================= -->
      <StackPanel Spacing="14" IsVisible="{Binding Tab1Visible}">
        <Border Classes="card" Padding="18">
          <StackPanel Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="icon-chip" Width="28" Height="28">
                <Path Classes="icon white" Data="{StaticResource I.HardDrive}" Width="14" Height="14" />
              </Border>
              <TextBlock Classes="card-title" Text="{DynamicResource L.set.rcloneTitle}" FontSize="15" VerticalAlignment="Center" />
            </StackPanel>
            <Border Classes="field">
              <StackPanel Spacing="8">
                <TextBlock Text="{DynamicResource L.set.rclonePath}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextMain}" />
                <TextBox Text="{Binding RclonePath}" PlaceholderText="{DynamicResource L.set.rclonePathPlaceholder}" />
                <Button Classes="btn btn-secondary" HorizontalAlignment="Left" Padding="8,4"
                        Command="{Binding BrowseRcloneCommand}">
                  <Path Classes="icon secondary" Data="{StaticResource I.Folder}" Width="14" Height="14" />
                </Button>
              </StackPanel>
            </Border>
            <TextBlock Classes="muted" Text="{DynamicResource L.set.rcloneNote}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- ================= Tab 2：应用程序 ================= -->
      <StackPanel Spacing="14" IsVisible="{Binding Tab2Visible}">
        <Border Classes="card" Padding="18">
          <StackPanel Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="icon-chip" Width="28" Height="28">
                <Path Classes="icon white" Data="{StaticResource I.Monitor}" Width="14" Height="14" />
              </Border>
              <TextBlock Classes="card-title" Text="{DynamicResource L.set.appTitle}" FontSize="15" VerticalAlignment="Center" />
            </StackPanel>
            <Border Classes="field">
              <StackPanel Spacing="8">
                <TextBlock Text="{DynamicResource L.set.language}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextMain}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <ComboBox ItemsSource="{Binding Languages}"
                            SelectedItem="{Binding SelectedLanguage}"
                            MinWidth="180" MinHeight="32" VerticalAlignment="Center" />
                  <TextBlock Text="{DynamicResource L.set.languageNote}" Classes="muted"
                             VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Classes="field">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <ToggleSwitch IsChecked="{Binding LaunchOnSystemStartup}" IsEnabled="{Binding AutostartOk}"
                              VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource L.set.launchOnStartup}" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMain}" />
                <TextBlock Text="{Binding AutostartNote}" Classes="muted" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <Border Classes="field">
              <StackPanel Spacing="6">
                <TextBlock Text="{DynamicResource L.set.settingsPath}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextMain}" />
                <TextBlock Text="{Binding SettingsPathText}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <TextBlock Text="{Binding StatusText}" Classes="muted" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
