<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- EF Core 10 dropped MigrationsNamespace; the assembly name itself
         disambiguates the SQLite migration set from the PostgreSQL one.
         Generated migrations live in this project's root namespace. -->
    <RootNamespace>OpenList.Migrations.Sqlite</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenList.Infrastructure\OpenList.Infrastructure.csproj" />
    <ProjectReference Include="..\OpenList.Media.Domain\OpenList.Media.Domain.csproj" />
  </ItemGroup>

</Project>
