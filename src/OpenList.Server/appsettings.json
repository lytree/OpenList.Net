{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSecret": "",
  "TokenExpiresIn": 48,
  "AdminUsername": "admin",
  "AdminPassword": "admin",
  "Database": {
    "Type": "sqlite",
    "DBFile": "data/data.db",
    "Host": "localhost",
    "Port": 5432,
    "User": "",
    "Password": "",
    "Name": "openlist",
    "TablePrefix": "x_"
  },
  "DistDir": "../../frontend",
  "TempDir": "data/temp",
  "Scheme": {
    "Address": "0.0.0.0",
    "HttpPort": 5244
  },
  "Cors": {
    "AllowOrigins": ["*"],
    "AllowMethods": ["*"],
    "AllowHeaders": ["*"]
  },
  "S3": {
    "Enable": false,
    "Port": 5246
  },
  "FTP": {
    "Enable": false,
    "Listen": ":5221"
  },
  "SFTP": {
    "Enable": false,
    "Listen": ":5222"
  },
  "SearchIndex": "database",
  "MaxConnections": 0,
  "Log": {
    "Enable": true,
    "Name": "logs/openlist.log",
    "MaxSize": 50,
    "MaxBackups": 30,
    "MaxAge": 28,
    "Compress": false,
    "Filter": {
      "Enable": false,
      "Filters": [
        { "Path": "/ping" },
        { "Method": "HEAD" },
        { "Path": "/dav/", "Method": "PROPFIND" }
      ]
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
